package com.projectzero.gates;

import net.minecraft.util.StringRepresentable;
import net.minecraft.world.level.block.Block;
import net.minecraft.world.phys.shapes.Shapes;
import net.minecraft.world.phys.shapes.VoxelShape;

import java.util.EnumMap;
import java.util.List;
import java.util.Locale;
import java.util.Map;

/**
 * GENERATED by tools/ancient_gate/gen.py together with the ancient_gate_stone models and blockstate.
 * Edit the generator and rerun it, not this file.
 *
 * Each ring piece is the slice of a one-block-thick annulus around the rift that falls inside one
 * block cell, built from 4x4 px squares, so the stones form a real circle instead of a square
 * frame. {@code plate_high} and {@code plate_low} are worn paving, a quarter and an eighth of a block
 * tall. {@code m_xxxx} names carry that 16-bit mask; {@code k_xxxx} are the keystones at the crown.
 */
public enum AncientStonePiece implements StringRepresentable {
@@PIECES@@;

    public enum Kind { RING, KEYSTONE, RUBBLE, SEAL, PLATE }

    /** One ring cell: its offset from the portal anchor (u along the width, h up) and its piece. */
    public record Cell(int u, int h, AncientStonePiece piece) {}

    private static final Map<GateSize, List<Cell>> RING = new EnumMap<>(GateSize.class);

    static {
@@RING@@
    }

    private final Kind kind;
    private final VoxelShape shapeX;
    private final VoxelShape shapeZ;

    AncientStonePiece(Kind kind, double[][] boxes) {
        this.kind = kind;
        VoxelShape x = Shapes.empty();
        VoxelShape z = Shapes.empty();
        for (double[] b : boxes) {
            x = Shapes.or(x, Block.box(b[0], b[1], b[2], b[3], b[4], b[5]));
            // The Z-axis model is the X/Y-plane model turned 90 degrees: model x becomes world z.
            z = Shapes.or(z, Block.box(b[2], b[1], b[0], b[5], b[4], b[3]));
        }
        this.shapeX = x;
        this.shapeZ = kind == Kind.SEAL || kind == Kind.PLATE ? x : z;
    }

    public Kind kind() { return kind; }

    public VoxelShape shape(boolean alongX) { return alongX ? shapeX : shapeZ; }

    /** Ring cells for a portal of this size, matching the rift drawn by GateRiftRenderer. */
    public static List<Cell> ring(GateSize size) { return RING.get(size); }

    @Override
    public String getSerializedName() { return name().toLowerCase(Locale.ROOT); }
}
